    "h_s = []\n",
    "u_s = []\n",
    "M_array = [14.8,    #Cygnus-X1 \n",
    "           15.65,   #M33 X-7\n",
    "           7.5,     #XTE J1118+480      \n",
    "           11,      #GS 1124-684 \n",
    "           6.98        #LMC X-3\n",
    "           ]\n",
    "L_array = [5.74e+19,\n",
    "           2.59e+22,\n",
    "           5.25e+19,\n",
    "           1.53e+20,\n",
    "           1.48e+21\n",
    "           ]\n",
    "\n",
    "label = ['Cygnus-X1', 'M33 X-7', 'XTE J1118+480', 'GS 1124-684', 'LMC X-3']\n",
    "\n",
    "for M, L in zip(M_array, L_array):\n",
    "    M_kg = M * M_sun\n",
    "    L_rescale = G_SI*M_kg/c_SI**2   #rescaling length\n",
    "    t_rescale = G_SI*M_kg/c_SI**3   #rescaling time\n",
    "    h = h_p_inf * (L_rescale / L)\n",
    "    u_time_sec = u_time * t_rescale\n",
    "    h_s.append(h)\n",
    "    u_s.append(u_time_sec)\n",
    "\n",
    "h_s = np.array(h_s)\n",
    "u_s = np.array(u_s)\n",
    "\n",
    "\n",
    "N = h_s.shape[1]\n",
    "\n",
    "fft_strain = []\n",
    "fft_freqs = []\n",
    "h_char = []\n",
    "ligo_noise_strain = []\n",
    "\n",
    "\n",
    "for i in range(len(M_array)):\n",
    "\n",
    "    dt = u_s[i, 1] - u_s[i, 0]\n",
    "\n",
    "    # Hann window\n",
    "    window = np.hanning(N)\n",
    "\n",
    "    h_windowed = h_s[i]\n",
    "\n",
    "    # FFT\n",
    "    fft = np.fft.rfft(h_windowed)\n",
    "\n",
    "    freqs = np.fft.rfftfreq(N, d=dt)\n",
    "\n",
    "    amplitude = np.abs(fft)\n",
    "\n",
    "    hc = 2.0 * freqs * dt * np.abs(fft)\n",
    "\n",
    "    flen = len(freqs)\n",
    "    delta_f = freqs[1] - freqs[0]\n",
    "    flow = 10.0\n",
    "    psd = pycbc.psd.aLIGOZeroDetHighPower(flen, delta_f, flow)\n",
    "\n",
    "    hn = np.sqrt(freqs * np.asarray(psd[:]))\n",
    "\n",
    "    fft_strain.append(fft)\n",
    "    fft_freqs.append(freqs)\n",
    "    h_char.append(hc)\n",
    "    ligo_noise_strain.append(hn)\n",
    "\n",
    "fft_strain = np.array(fft_strain)\n",
    "fft_freqs = np.array(fft_freqs)"
   ]
  },
