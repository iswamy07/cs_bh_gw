    "#Constants-------\n",
    "G_SI = 6.67430e-11       # m^3 kg^-1 s^-2\n",
    "c_SI = 299792458.0       # m s^-1\n",
    "M_sun = 1.98847e30       # kg\n",
    "M_p = 14.8*M_sun         #Physical Black hole mass\n",
    "D_l = 5.74e+19     #source distance (m)\n",
    "L_m = G_SI*M_p/c_SI**2   #rescaling length\n",
    "t_m = G_SI*M_p/c_SI**3   #rescaling time\n",
    "\n",
    "#Parameters------\n",
    "\n",
    "M = 1       #Dimensionless black hole mass. All other parameters are scaled by the physical mass.\n",
    "mu = 1e-6 #String tension\n",
    "E = M * 5    #String energy parameter\n",
    "l = np.array([2,4,6,8])     #Mode\n",
    "m = 0       #Mode\n",
    "\n",
    "\n",
    "Nt = 50000  #time values \n",
    "Nr = 50000   #radial values\n",
    "\n",
    "#Variables-------\n",
    "\n",
    "#Coordinates\n",
    "theta = np.pi/2     #plane of motion \n",
    "\n",
    "target_rs_values = [5.5, 4.5, 3.5, 2.5]\n",
    "r_obs = np.array([100*M, 3500*M])"
   ]
  },
