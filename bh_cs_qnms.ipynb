    "import pycbc.psd\n",
    "f_nz = fft_freqs_s[1:]\n",
    "h_characteristic = 2.0 * f_nz * dt * np.abs(fft_strain_s[1:])\n",
    "\n",
    "flen_s = len(fft_strain_s)\n",
    "delta_f_s = fft_freqs_s[1] - fft_freqs_s[0]\n",
    "flow = 10.0\n",
    "psd = pycbc.psd.aLIGOZeroDetHighPower(flen_s, delta_f_s, flow)\n",
    "\n",
    "ligo_noise_strain = np.sqrt(f_nz * psd[1:])\n",
    "\n",
    "\n",
    "valid = (f_nz >= 10.0) & (f_nz <= 1500.0) & (psd[1:] > 0)\n",
    "snr = np.sqrt(np.sum((h_characteristic[valid] / ligo_noise_strain[valid])**2 * (delta_f_s / f_nz[valid])))\n",
    "\n",
    "print(f\"Optimal SNR: {snr:.2f}\")\n",
    "\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.plot(f_nz, h_characteristic, lw=1.5, label='BH-CS Source ($10\\\\text{ Mpc}$)')\n",
    "plt.plot(f_nz, ligo_noise_strain, color='black', linestyle='--', lw=1.2, label='Advanced LIGO Design Noise ($h_n$)')\n",
    "\n",
    "plt.xscale('log')\n",
    "plt.yscale('log')\n",
    "plt.xlim(10, 1e4)\n",
    "plt.ylim(10**-24, 10**-19)\n",
    "\n",
    "plt.xlabel(r'Physical Frequency $f$ (Hz)', fontsize=12)\n",
    "plt.ylabel(r'Characteristic Strain $h_c$ ', fontsize=12)\n",
